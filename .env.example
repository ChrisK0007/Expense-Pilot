# Run bash prepare.sh to generate a unique setup token.
SETUP_TOKEN=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_24_CHARACTERS
# Leave blank for manual receipts. Supply an accessible Ollama URL and installed vision model.
# Example address: http://192.168.1.10:11434 (your actual Unraid IP and Ollama port)
OLLAMA_URL=
OLLAMA_MODEL=
# true when accessing through an HTTPS reverse proxy; false for initial LAN HTTP setup.
COOKIE_SECURE=false
