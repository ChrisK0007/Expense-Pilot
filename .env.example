# Optional: set a random token of at least 24 characters to protect first-run owner creation.
# If blank, create your owner account before exposing the server remotely.
SETUP_TOKEN=
# Configure receipt AI inside Expense Pilot: Settings → Receipts & AI.
# true when accessing through an HTTPS reverse proxy; false for initial LAN HTTP setup.
COOKIE_SECURE=false
# Behind a reverse proxy or tunnel: the proxy's address or network, e.g. 172.18.0.2.
# Lets sign-in limits apply per visitor instead of to everyone at once. Leave blank otherwise.
TRUSTED_PROXIES=
# Automatic verified backups: daily at BACKUP_TIME (workspace time), keeping BACKUP_KEEP (0 turns them off).
# Stored in /data/backups unless a separate /backups folder is mounted (see compose.public.yaml).
BACKUP_KEEP=7
BACKUP_TIME=02:30

# Optional encrypted copies: mount an external destination at this container path,
# then save the recovery key and enable copies in Review tools → Mail & backup.
OFFSITE_BACKUP_DIR=
